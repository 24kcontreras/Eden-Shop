# Postgres de Supabase (Project Settings → Database → Connection string)
DATABASE_URL=
DIRECT_URL=

# Supabase (Project Settings → API) — para subir fotos desde el panel admin
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Clave secreta para firmar la cookie de sesión del admin (string largo y random)
SESSION_SECRET=

# Número de WhatsApp de la tienda (con código de país, sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=56946312281

# --- SEO ---
# Dominio público del sitio, sin barra final. Define el canonical, el sitemap
# y las URLs de los datos estructurados. En Vercel se deduce solo si se omite.
NEXT_PUBLIC_SITE_URL=https://www.edenshop.cl

# Código de verificación de Google Search Console (solo el valor del content=,
# no la etiqueta completa). Opcional: si está vacío no se emite la meta tag.
GOOGLE_SITE_VERIFICATION=
