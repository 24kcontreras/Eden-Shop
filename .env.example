# Postgres de Supabase (Project Settings → Database → Connection string)
# DATABASE_URL = "Transaction pooler" (puerto 6543, para las consultas normales de la app)
# DIRECT_URL   = "Direct connection" o "Session pooler" (puerto 5432, solo la usa `prisma migrate`)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-xxx.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API) — usadas para subir fotos desde el panel admin a Supabase Storage
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Contraseña para entrar a /admin
ADMIN_PASSWORD=""

# Clave secreta para firmar la cookie de sesión del admin (cualquier string largo y random)
SESSION_SECRET=""

