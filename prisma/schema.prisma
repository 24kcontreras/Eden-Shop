generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id         String   @id @default(cuid())
  name       String
  desc       String
  material   String   @default("")
  price      Int
  offerPrice Int?
  sizes      Json
  stock      Json
  colors     Json
  img        String
  imgPos     String   @default("center 40%")
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Look {
  id         String   @id @default(cuid())
  name       String
  productIds Json
  price      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  orderNumber Int      @unique @default(autoincrement())
  items       Json
  total       Int
  status      String   @default("nuevo")
  createdAt   DateTime @default(now())
}

// Fila única (id fijo "singleton") con textos editables del catálogo, como el mensaje del ticker.
model Settings {
  id         String   @id @default("singleton")
  tickerText String   @default("Envíos a domicilio · Otoño · Invierno 26 · +56 9 4631 2281")
  updatedAt  DateTime @updatedAt
}
